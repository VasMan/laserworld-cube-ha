  "services": {
    "play_overview_tile": {
      "name": "Play overview tile",
      "description": "Play the pattern shown in a tile of the library overview image.",
      "fields": {
        "tile": {
          "name": "Tile",
          "description": "Tile number 1-20, counted left to right, top to bottom."
        }
      }
    },
    "overview_next_page": {
      "name": "Overview next page",
      "description": "Show the next page of the library overview image."
    },
    "overview_previous_page": {
      "name": "Overview previous page",
      "description": "Show the previous page of the library overview image."
    },
    "send_effect": {
      "name": "Send effect channels (experimental)",
      "description": "Send raw effect channel values to the laser together with the text, like the official app does. An empty list removes the effect.",
      "fields": {
        "channels": {
          "name": "Channels",
          "description": "List of channel values (0-255)."
        },
        "step": {
          "name": "Step",
          "description": "Effect step index."
        },
        "steps": {
          "name": "Steps",
          "description": "Total number of steps."
        },
        "duration": {
          "name": "Duration",
          "description": "Step duration in seconds."
        }
      }
    },
    "playlist_add_tile": {
      "name": "Add overview tile to playlist",
      "description": "Add the pattern in a tile of the library overview image to the active playlist.",
      "fields": {
        "tile": {
          "name": "Tile",
          "description": "Tile number 1-20."
        },
        "duration": {
          "name": "Duration",
          "description": "How long the pattern stays on, in seconds."
        }
      }
    },
    "playlist_add": {
      "name": "Add pattern to playlist",
      "description": "Add a pattern from any library to a playlist.",
      "fields": {
        "library": {
          "name": "Library",
          "description": "Library name, e.g. Hotspot (default: the selected library)."
        },
        "pattern": {
          "name": "Pattern",
          "description": "Pattern number (default: the current one)."
        },
        "duration": {
          "name": "Duration",
          "description": "How long the pattern stays on, in seconds."
        },
        "playlist": {
          "name": "Playlist",
          "description": "Playlist name (default: the active one)."
        },
        "position": {
          "name": "Position",
          "description": "Insert at this position (default: the end)."
        }
      }
    },
    "playlist_remove": {
      "name": "Remove playlist item",
      "description": "Remove an item (default: the last one).",
      "fields": {
        "index": {
          "name": "Item",
          "description": "Item number."
        },
        "playlist": {
          "name": "Playlist",
          "description": "Playlist name (default: the active one)."
        }
      }
    },
    "playlist_set_duration": {
      "name": "Set playlist item duration",
      "description": "Change how long one item stays on.",
      "fields": {
        "index": {
          "name": "Item",
          "description": "Item number."
        },
        "duration": {
          "name": "Duration",
          "description": "How long the pattern stays on, in seconds."
        },
        "playlist": {
          "name": "Playlist",
          "description": "Playlist name (default: the active one)."
        }
      }
    },
    "playlist_move": {
      "name": "Move playlist item",
      "description": "Move an item to another position.",
      "fields": {
        "index": {
          "name": "Item",
          "description": "Item number."
        },
        "to": {
          "name": "To",
          "description": "New position."
        },
        "playlist": {
          "name": "Playlist",
          "description": "Playlist name (default: the active one)."
        }
      }
    },
    "show_image": {
      "name": "Show image",
      "description": "Convert a picture to laser lines (locally, nothing is uploaded) and show it on the laser.",
      "fields": {
        "media": {
          "name": "Media",
          "description": "A picture from Home Assistant's media (upload via Media > My media)."
        },
        "path": {
          "name": "Path",
          "description": "Alternatively a file path (/media/..., /local/...) or a URL."
        },
        "mode": {
          "name": "Mode",
          "description": "Outline (edges), Silhouette (shapes) or Lines (single centre lines)."
        },
        "detail": {
          "name": "Detail",
          "description": "1-100: how many lines and points to keep."
        },
        "color": {
          "name": "Color",
          "description": "Colors from the picture, a single color, or rainbow."
        },
        "size": {
          "name": "Size",
          "description": "10-100 % of the laser's frame."
        },
        "invert": {
          "name": "Invert",
          "description": "Use light picture parts as the drawing (for light-on-dark pictures)."
        }
      }
    },
    "playlist_rename": {
      "name": "Rename playlist",
      "description": "Give a playlist a new name (default: the active playlist).",
      "fields": {
        "name": {
          "name": "New name",
          "description": "Up to 40 characters."
        },
        "playlist": {
          "name": "Playlist",
          "description": "Playlist to rename (default: the active one)."
        }
      }
    },
    "playlist_create": {
      "name": "Create playlist",
      "description": "Create a new, empty playlist and make it the active one.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Optional; default Playlist 1, 2, ..."
        }
      }
    }
  }
}
